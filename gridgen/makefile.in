#
# makefile.in - Input makefile for the configure script.
#               (MinGW/MSYS2 correspondence version)
#

SHELL = /bin/sh

#### Start of system configuration section. ####

prefix = @prefix@
exec_prefix = @exec_prefix@

bindir = @bindir@
libdir = @libdir@
includedir = @includedir@

INSTALLDIRS =\
$(bindir)\
$(libdir)\
$(includedir)

DISTDIR = ~/pub_web

INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@

NOCOMPLEX = @NOCOMPLEX@
HAVE_GRIDNODES_H = @HAVE_GRIDNODES_H@

CC = @CC@
CFLAGS = @CFLAGS@
CFLAGS_TRIANGLE = @CFLAGS_TRIANGLE@
LDFLAGS = @LDFLAGS@

AR = @AR@
ARFLAGS = cru
RANLIB = @RANLIB@
STRIP = @STRIP@

LIBS = @LIBS@

MLIB = -lm

# --- host dependent (determined by configure) ------------------------
# EXEEXT        : ".exe" on Windows, empty on Unix
# PICFLAG       : "-fPIC" on Unix, empty on Windows (not needed for DLLs)
# SHLIB         : libgridgen.dll / libgridgen.so / libgridgen.dylib
# SHLIB_LDFLAGS : -shared -Wl,--out-implib,... etc.
EXEEXT = @EXEEXT@
PICFLAG = @PICFLAG@
SHLIB = @SHLIB@
SHLIB_LDFLAGS = @SHLIB_LDFLAGS@
WIN32 = @WIN32@

PROG = gridgen$(EXEEXT)

#### end of configuration section ####

SRC =\
broyden.c\
delaunay.c\
geom.c\
gridgen.c\
hash.c\
issimplepoly.c\
istack.c\
ode.c\
swcr.c\
vertlist.c\
zode.c

HEADERS =\
broyden.h\
delaunay.h\
geom.h\
gridgen.h\
hash.h\
issimplepoly.h\
istack.h\
nan.h\
ode.h\
swcr.h\
version.h\
vertlist.h\
zode.h

ifeq ($(NOCOMPLEX),yes)
  COMPLEXSRC =\
  c99-min/clog.c\
  c99-min/cmplx.c\
  c99-min/stubs.c
endif

LIBSRC=$(SRC) $(COMPLEXSRC)

LIBOBJS = $(LIBSRC:.c=.o)
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

SHLIBOBJS = $(LIBSRC:.c=.t)
%.t: %.c
	$(CC) $(CFLAGS) $(PICFLAG) -c $< -o $@

all: $(PROG)
	@if [ ! -f libgridgen.a ] ; then \
	   echo "  type 'make lib' to make libgridgen.a"; \
	fi
	@if [ ! -f $(SHLIB) ] ; then \
	   echo "  type 'make shlib' to make $(SHLIB)"; \
	fi

lib: libgridgen.a

shlib: $(SHLIB)

$(PROG): main.c $(HEADERS) $(SRC) triangle.o
	$(CC) -o $(PROG) -DGRIDGEN_STANDALONE $(CFLAGS) main.c $(SRC) triangle.o $(LDFLAGS) $(MLIB)

tests: broyden.c issimplepoly.c hash.c
	$(CC) -o test_broyden$(EXEEXT) broyden.c -DTEST_BROYDEN $(CFLAGS) -I. $(MLIB)
	$(CC) -o issimplepoly$(EXEEXT) issimplepoly.c -DTEST_SI $(CFLAGS) -I. $(MLIB)
	$(CC) -o test_hash$(EXEEXT) hash.c -DHT_TEST $(CFLAGS) -I. $(MLIB)

standalone: override CFLAGS+=-static
standalone: $(PROG) tests
	$(STRIP) $(PROG)
	$(STRIP) issimplepoly$(EXEEXT)

libgridgen.a: $(HEADERS) triangle.o $(LIBOBJS)
	$(AR) $(ARFLAGS) $@ $(LIBOBJS) triangle.o
	-$(RANLIB) $@
	-chmod go+r $@

$(SHLIB): $(HEADERS) triangle.t $(SHLIBOBJS)
	rm -f $@
	$(CC) $(SHLIB_LDFLAGS) -o $@ $(SHLIBOBJS) triangle.t $(LDFLAGS) $(LIBS) $(MLIB)

triangle.o: triangle.c
	$(CC) -c -DTRILIBRARY $(CFLAGS_TRIANGLE) -I. triangle.c -o triangle.o

triangle.t: triangle.c
	$(CC) -c -DTRILIBRARY $(CFLAGS_TRIANGLE) $(PICFLAG) -I. triangle.c -o triangle.t

installdirs: $(INSTALLDIRS)
	@$(SHELL) mkinstalldirs $(INSTALLDIRS)

install: all installdirs
	@for i in $(PROG); do \
	   echo "  installing $$i"; \
	   $(INSTALL_PROGRAM) $$i $(bindir); \
	done
	@for i in gridgen.h; do \
	   echo "  installing $$i"; \
	   $(INSTALL_DATA) $$i $(includedir); \
	done
	@for i in libgridgen.a $(SHLIB) libgridgen.dll.a; do \
	   if test -f $$i; then \
	      echo "  installing $$i"; \
	      $(INSTALL_DATA) $$i $(libdir)/$$i; \
	   fi \
	done

clean:
	rm -f *.o *.t c99-min/*.o *.a *.so *.dll *.dylib *~ \#*\# core \
	gridgen gridgen.exe issimplepoly issimplepoly.exe \
	test_broyden test_broyden.exe test_hash test_hash.exe

configclean:
	rm -f config.h makefile config.cache config.status config.log

distclean: clean configclean

indent:
	indent -T FILE -T swcr -T vertnode -T vertlist -T edge -T quadrilateral -T gridgen -T odestruct -T calcstruct -T zdouble -T point -T delaunay -T istack -T triangle -T DIRECTION -T endpoint -T endpointtqueue -T slseg -T segnode -T sweepline  -T DIRECTION -T VISIT -T SIBLING_ORDER -T NODETYPE -T ht_bucket -T hashtable -T sgproj main.c $(SRC) $(HEADERS)
	rm -f *~
