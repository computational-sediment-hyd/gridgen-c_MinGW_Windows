# This file is for customizing the configuation process performed by
# `./configure'.  This file consists of sh(1) variable-definition lines.
# The value given to those variables by this file will override their default
# values.
#
# Be sure to test whether the variable doesn't exists before setting it.
#
# You can also customize the configuration process via the environment
# variables seen by ./configure.  For example:
#
#     In sh(1), bash(1) or the MSYS2/MinGW shell:
#	  $ CC=gcc CFLAGS=-g ./configure
#
# Variables in this file override the environmental ones.
#
#############################################################################

# C compiler
# NOTE: do not override CC when cross-compiling (./configure --host=...),
#       otherwise the cross compiler chosen by AC_PROG_CC would be clobbered.
if [ -z "$CC" ] && [ -z "$host_alias" ]; then
  CC=gcc
fi

# C compiler flags
if [ -z "$CFLAGS" ]; then
  CFLAGS="-g -O2 -Wall -DANSI_DECLARATORS"
fi

CFLAGS_TRIANGLE="$CFLAGS -w -ffloat-store"

# Linker flags
# On MinGW/MSYS2 there is no /usr/local/lib in the native (Windows) sense,
# so do not force it onto the link line there.
if [ -z "$LDFLAGS" ]; then
  case "${host_os}" in
    mingw* | msys* | cygwin*)
      LDFLAGS=""
      ;;
    *)
      LDFLAGS="-L/usr/local/lib"
      ;;
  esac
fi

# Installation prefix (default is /usr/local)
if [ "${prefix}" = "NONE" ]; then
   prefix=/usr/local
fi

if [ "${libdir}" = "\${exec_prefix}/lib" ]; then
   libdir="${prefix}/lib${LIBEXT}"
fi

echo "Using prefix ${prefix}"
echo "Using libdir ${libdir}"
